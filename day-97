#include <stdio.h>

struct Employee {
    char name[50];
    int emp_id;
    float salary;
};

int main() {
    struct Employee e[2]; 
    FILE *fp;
    int i;

    for (i = 0; i < 2; i++) {
        printf("\nEnter details of Employee %d:\n", i + 1);
        printf("Name: ");
        scanf(" %[^\n]", e[i].name);
        printf("Employee ID: ");
        scanf("%d", &e[i].emp_id);
        printf("Salary: ");
        scanf("%f", &e[i].salary);
    }

    fp = fopen("employees.bin", "wb");
    if (fp == NULL) {
        printf("Error opening file for writing.\n");
        return 1;
    }
    fwrite(e, sizeof(struct Employee), 2, fp);
    fclose(fp);

    struct Employee emp_read[2];
    fp = fopen("employees.bin", "rb");
    if (fp == NULL) {
        printf("Error opening file for reading.\n");
        return 1;
    }
    fread(emp_read, sizeof(struct Employee), 2, fp);
    fclose(fp);

    printf("\n--- Employee Details from File ---\n");
    for (i = 0; i < 2; i++) {
        printf("\nEmployee %d:\n", i + 1);
        printf("Name: %s\n", emp_read[i].name);
        printf("Employee ID: %d\n", emp_read[i].emp_id);
        printf("Salary: %.2f\n", emp_read[i].salary);
    }

    return 0;
}

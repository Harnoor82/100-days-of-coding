#include <stdio.h>

int main() {
    int r, c;
    printf("Enter rows and columns: ");
    scanf("%d", &r);
    scanf("%d", &c);

    int a[r][c];
    printf("Enter matrix elements:\n");

    for(int i = 0; i < r; i++)
        for(int j = 0; j < c; j++)
            scanf("%d", &a[i][j]);

    printf("Diagonal traversal:\n");

    for(int i = 0; i < r && i < c; i++) {
        printf("%d ", a[i][i]);
    }

    return 0;
}
